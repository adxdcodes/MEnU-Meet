VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional: only if you later choose the LiveKit development token server.
# The current MVP uses the Supabase Edge Function below, so do not put
# LIVEKIT_API_KEY or LIVEKIT_API_SECRET in the Vite frontend environment.
# VITE_LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
# VITE_LIVEKIT_TOKEN_SERVER_ID=YOUR_DEVELOPMENT_TOKEN_SERVER_ID
